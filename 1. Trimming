#Create a .txt file containing the name of files to trim (without the extension)

#PBS -lwalltime=24:00:00
#PBS -lselect=1:ncpus=16:mem=128g

cd $PBS_O_WORKDIR

eval "$(/rds/general/user/nfa23/home/anaconda3/bin/conda shell.bash hook)"
for name in $(cat $PBS_O_WORKDIR/FILE_NAME.txt)
do
base_name=$(echo $name | sed 's/_R[12]$//')
/rds/general/user/nfa23/home/anaconda3/bin/fastp -i $PBS_O_WORKDIR/${base_name}_R1.fq.gz -I $PBS_O_WORKDIR/${base_name}_R2.fq.gz -o trimmed_${base_name}_R1.fq.gz -O trimmed_${base_name}_R2.fq.gz --detect_adapter_for_pe -w 16 -l 20 -j ${base_name}.fastp.json -h ${base_name}.fastp.html
done
